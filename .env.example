# Copy this file to ".env" and fill in your credentials.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Massive (Polygon-compatible market data)
MASSIVE_API_KEY=

# SnapTrade (brokerage integration)
# SNAPTRADE_CLIENT_ID looks like "PERS-XXXXXXXXXXXX" (or "TEST-...").
SNAPTRADE_CLIENT_ID=
# SNAPTRADE_CONSUMER_KEY is the long API/consumer key from your SnapTrade dashboard.
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_REDIRECT_URI=http://localhost:8000/snaptrade/success/

# Strategy configuration
MOMENTUM_LOOKBACK_MONTHS=12
MOMENTUM_SKIP_MONTHS=1
REBALANCE_FREQUENCY=monthly
